{
  "name": "n8n-nodes-washoot",
  "version": "1.0.0",
  "description": "n8n community node for Washoot — WhatsApp automation for WooCommerce and any business",
  "keywords": [
    "n8n-community-node-package",
    "whatsapp",
    "woocommerce",
    "automation",
    "washoot"
  ],
  "license": "MIT",
  "homepage": "https://washoot.com",
  "author": {
    "name": "Washoot",
    "email": "support@washoot.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/washoot/n8n-nodes-washoot"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "prepublishOnly": "npm run build && npm run lint -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WashootApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Washoot/Washoot.node.js",
      "dist/nodes/Washoot/WashootTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
